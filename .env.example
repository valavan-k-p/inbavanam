# Copy to .env.local and fill in. Never commit real values.

# Public base URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (optional until the admin and enquiry storage are needed).
# Dashboard > Project Settings > API. Use the publishable (anon) key only:
# the service-role key must never be given to this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Contact details. Leave empty until confirmed by the client; the site
# shows "Information to be confirmed" for any value that is not set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_MAP_URL=

# External donation page, once one exists.
NEXT_PUBLIC_SUPPORT_URL=
